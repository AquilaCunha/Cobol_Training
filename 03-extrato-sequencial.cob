>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. EXTRATO-SEQUENCIAL.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ARQ-EXTRATO ASSIGN TO "financeiro/dados/extrato.txt"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-STATUS.

DATA DIVISION.
FILE SECTION.
FD ARQ-EXTRATO.
01 REG-EXTRATO          PIC X(80).

WORKING-STORAGE SECTION.
01 WS-STATUS            PIC XX.
01 WS-DATA              PIC X(10).
01 WS-DESCRICAO         PIC X(30).
01 WS-TIPO              PIC X.
01 WS-VALOR             PIC 9(7)V99.
01 WS-LINHA             PIC X(80).
01 WS-FIM               PIC X VALUE "N".

PROCEDURE DIVISION.
    OPEN OUTPUT ARQ-EXTRATO
    PERFORM UNTIL WS-FIM = "S"
        DISPLAY "Data (DD/MM/AAAA ou FIM): " WITH NO ADVANCING
        ACCEPT WS-DATA
        IF WS-DATA = "FIM"
            MOVE "S" TO WS-FIM
        ELSE
            DISPLAY "Descricao: " WITH NO ADVANCING
            ACCEPT WS-DESCRICAO
            DISPLAY "Tipo (C/D): " WITH NO ADVANCING
            ACCEPT WS-TIPO
            DISPLAY "Valor: " WITH NO ADVANCING
            ACCEPT WS-VALOR
            STRING WS-DATA DELIMITED BY SIZE
                   ";" DELIMITED BY SIZE
                   WS-TIPO DELIMITED BY SIZE
                   ";" DELIMITED BY SIZE
                   WS-DESCRICAO DELIMITED BY SIZE
                   ";" DELIMITED BY SIZE
                   WS-VALOR DELIMITED BY SIZE
              INTO WS-LINHA
            END-STRING
            WRITE REG-EXTRATO FROM WS-LINHA
        END-IF
    END-PERFORM
    CLOSE ARQ-EXTRATO

    DISPLAY "Extrato gravado:"
    OPEN INPUT ARQ-EXTRATO
    PERFORM UNTIL WS-STATUS = "10"
        READ ARQ-EXTRATO
            AT END CONTINUE
            NOT AT END DISPLAY REG-EXTRATO
        END-READ
    END-PERFORM
    CLOSE ARQ-EXTRATO
    GOBACK.
