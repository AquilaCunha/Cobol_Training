>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. ARQUIVO-SEQUENCIAL.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ARQ-ALUNOS ASSIGN TO "dados/alunos.txt"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-STATUS-ARQUIVO.

DATA DIVISION.
FILE SECTION.
FD ARQ-ALUNOS.
01 REG-ALUNO            PIC X(60).

WORKING-STORAGE SECTION.
01 WS-STATUS-ARQUIVO    PIC XX.
01 WS-NOME              PIC X(30).
01 WS-NOTA              PIC 9(2)V9.
01 WS-LINHA             PIC X(60).
01 WS-FIM               PIC X VALUE "N".

PROCEDURE DIVISION.
    OPEN OUTPUT ARQ-ALUNOS
    IF WS-STATUS-ARQUIVO NOT = "00"
        DISPLAY "Erro ao criar arquivo. Status: " WS-STATUS-ARQUIVO
        GOBACK
    END-IF

    PERFORM UNTIL WS-FIM = "S"
        DISPLAY "Nome do aluno (FIM para encerrar): " WITH NO ADVANCING
        ACCEPT WS-NOME
        IF WS-NOME = "FIM"
            MOVE "S" TO WS-FIM
        ELSE
            DISPLAY "Nota: " WITH NO ADVANCING
            ACCEPT WS-NOTA
            STRING WS-NOME DELIMITED BY SIZE
                   ";" DELIMITED BY SIZE
                   WS-NOTA DELIMITED BY SIZE
              INTO WS-LINHA
            END-STRING
            WRITE REG-ALUNO FROM WS-LINHA
        END-IF
    END-PERFORM
    CLOSE ARQ-ALUNOS

    DISPLAY "Conteudo gravado em dados/alunos.txt:"
    OPEN INPUT ARQ-ALUNOS
    PERFORM UNTIL WS-STATUS-ARQUIVO = "10"
        READ ARQ-ALUNOS
            AT END CONTINUE
            NOT AT END DISPLAY REG-ALUNO
        END-READ
    END-PERFORM
    CLOSE ARQ-ALUNOS
    GOBACK.
