>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. FLUXO-DE-CAIXA.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-LANCAMENTOS.
   05 WS-LANCAMENTO OCCURS 5 TIMES.
      10 WL-DESCRICAO    PIC X(25).
      10 WL-TIPO         PIC X.
      10 WL-VALOR        PIC 9(7)V99.
01 WS-INDICE             PIC 9 VALUE ZERO.
01 WS-ENTRADAS           PIC 9(8)V99 VALUE ZERO.
01 WS-SAIDAS             PIC 9(8)V99 VALUE ZERO.
01 WS-RESULTADO          PIC S9(8)V99 VALUE ZERO.

PROCEDURE DIVISION.
    PERFORM VARYING WS-INDICE FROM 1 BY 1 UNTIL WS-INDICE > 5
        DISPLAY "Lancamento " WS-INDICE
        DISPLAY "Descricao: " WITH NO ADVANCING
        ACCEPT WL-DESCRICAO(WS-INDICE)
        DISPLAY "Tipo (E=entrada, S=saida): " WITH NO ADVANCING
        ACCEPT WL-TIPO(WS-INDICE)
        DISPLAY "Valor: " WITH NO ADVANCING
        ACCEPT WL-VALOR(WS-INDICE)
    END-PERFORM

    PERFORM VARYING WS-INDICE FROM 1 BY 1 UNTIL WS-INDICE > 5
        EVALUATE WL-TIPO(WS-INDICE)
            WHEN "E"
                ADD WL-VALOR(WS-INDICE) TO WS-ENTRADAS
            WHEN "S"
                ADD WL-VALOR(WS-INDICE) TO WS-SAIDAS
            WHEN OTHER
                DISPLAY "Tipo ignorado no lancamento " WS-INDICE
        END-EVALUATE
    END-PERFORM

    COMPUTE WS-RESULTADO = WS-ENTRADAS - WS-SAIDAS
    DISPLAY ""
    DISPLAY "--- RESUMO DO FLUXO DE CAIXA ---"
    DISPLAY "Entradas:  " WS-ENTRADAS
    DISPLAY "Saidas:    " WS-SAIDAS
    DISPLAY "Resultado: " WS-RESULTADO
    IF WS-RESULTADO < ZERO
        DISPLAY "Alerta: o periodo fechou com deficit."
    ELSE
        DISPLAY "O periodo fechou com superavit."
    END-IF
    GOBACK.
