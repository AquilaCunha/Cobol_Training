>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CADASTRO-PRODUTOS.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ARQ-PRODUTOS ASSIGN TO "dados/produtos.txt"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-STATUS.

DATA DIVISION.
FILE SECTION.
FD ARQ-PRODUTOS.
01 REG-PRODUTO           PIC X(80).

WORKING-STORAGE SECTION.
01 WS-STATUS             PIC XX.
01 WS-OPCAO              PIC 9.
01 WS-CODIGO             PIC 9(5).
01 WS-NOME               PIC X(30).
01 WS-PRECO              PIC 9(5)V99.
01 WS-LINHA              PIC X(80).
01 WS-FIM                PIC X.

PROCEDURE DIVISION.
    PERFORM UNTIL WS-OPCAO = 3
        DISPLAY ""
        DISPLAY "1 - Cadastrar | 2 - Listar | 3 - Sair"
        DISPLAY "Opcao: " WITH NO ADVANCING
        ACCEPT WS-OPCAO
        EVALUATE WS-OPCAO
            WHEN 1 PERFORM CADASTRAR-PRODUTO
            WHEN 2 PERFORM LISTAR-PRODUTOS
            WHEN 3 DISPLAY "Encerrando cadastro."
            WHEN OTHER DISPLAY "Opcao invalida."
        END-EVALUATE
    END-PERFORM
    GOBACK.

CADASTRAR-PRODUTO.
    DISPLAY "Codigo: " WITH NO ADVANCING
    ACCEPT WS-CODIGO
    DISPLAY "Nome: " WITH NO ADVANCING
    ACCEPT WS-NOME
    DISPLAY "Preco: " WITH NO ADVANCING
    ACCEPT WS-PRECO

    OPEN EXTEND ARQ-PRODUTOS
    IF WS-STATUS = "35"
        OPEN OUTPUT ARQ-PRODUTOS
    END-IF
    IF WS-STATUS = "00"
        STRING WS-CODIGO DELIMITED BY SIZE
               ";" DELIMITED BY SIZE
               WS-NOME DELIMITED BY SIZE
               ";" DELIMITED BY SIZE
               WS-PRECO DELIMITED BY SIZE
          INTO WS-LINHA
        END-STRING
        WRITE REG-PRODUTO FROM WS-LINHA
        CLOSE ARQ-PRODUTOS
        DISPLAY "Produto cadastrado."
    ELSE
        DISPLAY "Falha ao abrir o arquivo. Status: " WS-STATUS
    END-IF.

LISTAR-PRODUTOS.
    MOVE "N" TO WS-FIM
    OPEN INPUT ARQ-PRODUTOS
    IF WS-STATUS = "35"
        DISPLAY "Nenhum produto cadastrado ainda."
    ELSE
        DISPLAY "CODIGO;NOME;PRECO"
        PERFORM UNTIL WS-FIM = "S"
            READ ARQ-PRODUTOS
                AT END MOVE "S" TO WS-FIM
                NOT AT END DISPLAY REG-PRODUTO
            END-READ
        END-PERFORM
        CLOSE ARQ-PRODUTOS
    END-IF.
