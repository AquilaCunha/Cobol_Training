>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. ORDENACAO-PRODUTOS.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ARQ-ENTRADA ASSIGN TO "dados/produtos-entrada.txt"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT ARQ-ORDENADO ASSIGN TO "dados/produtos-ordenados.txt"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT ARQ-SORT ASSIGN TO "dados/produtos-sort.tmp".

DATA DIVISION.
FILE SECTION.
FD ARQ-ENTRADA.
01 REG-ENTRADA          PIC X(50).
FD ARQ-ORDENADO.
01 REG-ORDENADO         PIC X(50).
SD ARQ-SORT.
01 REG-SORT.
   05 RS-NOME           PIC X(30).
   05 FILLER            PIC X.
   05 RS-PRECO          PIC 9(5)V99.

WORKING-STORAGE SECTION.
01 WS-FIM               PIC X VALUE "N".
01 WS-NOME              PIC X(30).
01 WS-PRECO             PIC 9(5)V99.

PROCEDURE DIVISION.
    *> Gera uma entrada de exemplo para que a etapa seja repetível.
    OPEN OUTPUT ARQ-ENTRADA
    MOVE "Caderno                       ;00012.50" TO REG-ENTRADA
    WRITE REG-ENTRADA
    MOVE "Caneta                        ;00003.75" TO REG-ENTRADA
    WRITE REG-ENTRADA
    MOVE "Apagador                      ;00008.00" TO REG-ENTRADA
    WRITE REG-ENTRADA
    CLOSE ARQ-ENTRADA

    SORT ARQ-SORT ON ASCENDING KEY RS-NOME
        USING ARQ-ENTRADA
        GIVING ARQ-ORDENADO

    DISPLAY "Produtos ordenados por nome:"
    OPEN INPUT ARQ-ORDENADO
    PERFORM UNTIL WS-FIM = "S"
        READ ARQ-ORDENADO
            AT END MOVE "S" TO WS-FIM
            NOT AT END DISPLAY REG-ORDENADO
        END-READ
    END-PERFORM
    CLOSE ARQ-ORDENADO
    GOBACK.
