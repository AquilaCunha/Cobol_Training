>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CONTAS-A-PAGAR.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ARQ-TITULOS ASSIGN TO "financeiro/dados/titulos.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD ARQ-TITULOS.
01 REG-TITULO.
   05 RT-FORNECEDOR      PIC X(30).
   05 FILLER             PIC X.
   05 RT-VENCIMENTO      PIC X(10).
   05 FILLER             PIC X.
   05 RT-VALOR           PIC 9(7)V99.

WORKING-STORAGE SECTION.
01 WS-FIM                PIC X VALUE "N".
01 WS-FORNECEDOR         PIC X(30).
01 WS-VENCIMENTO         PIC X(10).
01 WS-VALOR              PIC 9(7)V99.
01 WS-TOTAL-ABERTO       PIC 9(8)V99 VALUE ZERO.

PROCEDURE DIVISION.
    OPEN OUTPUT ARQ-TITULOS
    PERFORM UNTIL WS-FIM = "S"
        DISPLAY "Fornecedor (FIM para concluir): " WITH NO ADVANCING
        ACCEPT WS-FORNECEDOR
        IF WS-FORNECEDOR = "FIM"
            MOVE "S" TO WS-FIM
        ELSE
            DISPLAY "Vencimento (DD/MM/AAAA): " WITH NO ADVANCING
            ACCEPT WS-VENCIMENTO
            DISPLAY "Valor do titulo: " WITH NO ADVANCING
            ACCEPT WS-VALOR
            MOVE WS-FORNECEDOR TO RT-FORNECEDOR
            MOVE WS-VENCIMENTO TO RT-VENCIMENTO
            MOVE WS-VALOR TO RT-VALOR
            WRITE REG-TITULO
        END-IF
    END-PERFORM
    CLOSE ARQ-TITULOS

    DISPLAY ""
    DISPLAY "FORNECEDOR                     VENCIMENTO  VALOR"
    OPEN INPUT ARQ-TITULOS
    MOVE "N" TO WS-FIM
    PERFORM UNTIL WS-FIM = "S"
        READ ARQ-TITULOS
            AT END MOVE "S" TO WS-FIM
            NOT AT END
                ADD RT-VALOR TO WS-TOTAL-ABERTO
                DISPLAY RT-FORNECEDOR " " RT-VENCIMENTO " " RT-VALOR
        END-READ
    END-PERFORM
    CLOSE ARQ-TITULOS
    DISPLAY "Total a pagar: " WS-TOTAL-ABERTO
    GOBACK.
